{
  "name": "futsal-analyzer",
  "productName": "Futsal Analyzer",
  "version": "1.0.0",
  "description": "Analyse vidéo tactique de futsal par IA : détection des joueurs, vue de dessus, erreurs, corrections animées et base de connaissances.",
  "main": "main.js",
  "author": "CoachConvoc",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "assets": "node scripts/get-assets.js",
    "test": "node scripts/get-assets.js && node --test \"tests/*.test.js\"",
    "dist": "node scripts/get-assets.js --model-only && electron-builder --win nsis --x64 --publish never",
    "pack:linux": "node scripts/get-assets.js --model-only && electron-builder --linux dir --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "jpeg-js": "^0.4.4"
  },
  "build": {
    "appId": "com.coachconvoc.futsalanalyzer",
    "productName": "Futsal Analyzer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "labelsFs.js",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.md",
      "!**/*.map",
      "!node_modules/onnxruntime-node/{script,test}/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**"
    ],
    "asarUnpack": [
      "src/ai/**",
      "src/vendor/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**"
    ],
    "extraResources": [
      {
        "from": "models/yolox_s.onnx",
        "to": "models/yolox_s.onnx"
      },
      {
        "from": "models/yolox_m.onnx",
        "to": "models/yolox_m.onnx"
      },
      {
        "from": "models/mobile_sam_encoder.onnx",
        "to": "models/mobile_sam_encoder.onnx"
      },
      {
        "from": "models/mobile_sam_decoder.onnx",
        "to": "models/mobile_sam_decoder.onnx"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "!models/**",
        "!tests/**",
        "!scripts/**",
        "!dist/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
      ]
    },
    "linux": {
      "target": "dir",
      "files": [
        "!models/**",
        "!tests/**",
        "!scripts/**",
        "!dist/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Futsal Analyzer",
      "language": "1036",
      "artifactName": "Futsal-Analyzer-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "john5583",
        "repo": "futsal-video-analyzer"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "onnxruntime-node": "^1.20.1"
  }
}
